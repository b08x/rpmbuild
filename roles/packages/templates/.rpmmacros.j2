# RPM macros configuration for {{ packages_user | default(builder_user | default(ansible_user_id)) }}

# Build directories
%_topdir {{ packages_build_dir | default(builder_build_dir | default((packages_home_dir | default(builder_home_dir | default(ansible_env.HOME))) ~ '/rpmbuild')) }}
%_sourcedir %{_topdir}/SOURCES
%_specdir %{_topdir}/SPECS
%_builddir %{_topdir}/BUILD
%_srcrpmdir %{_topdir}/SRPMS
%_rpmdir %{_topdir}/RPMS

# Packager information
%packager {{ packages_user | default(builder_user | default(ansible_user_id)) }} <{{ packages_user | default(builder_user | default(ansible_user_id)) }}@{{ ansible_fqdn | default('localhost') }}>

# Distribution specific macros
{% if ansible_distribution == 'Fedora' %}
%dist .fc{{ ansible_distribution_major_version }}
%fedora {{ ansible_distribution_major_version }}
{% else %}
%dist .el{{ ansible_distribution_major_version }}
{% endif %}

# Build options
%_smp_mflags -j%(nproc)
%__make make %{_smp_mflags}

# Debug package settings
%debug_package %{nil}

# GPG signature settings (uncomment and configure as needed)
# %_signature gpg
# %_gpg_path ~/.gnupg
# %_gpg_name {{ packages_user | default(builder_user | default(ansible_user_id)) }}
# %_gpgbin /usr/bin/gpg2
